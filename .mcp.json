{
  "mcpServers": {
    "voicescribe": {
      "command": "${VOICESCRIBE_PYTHON:-python3}",
      "args": ["${CLAUDE_PROJECT_DIR}/voicescribe/scripts/mcp_launcher.py"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  }
}
